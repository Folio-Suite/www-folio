{
  "name": "www-folio",
  "version": "1.0.0",
  "private": true,
  "description": "The static Folio Suite development website",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-public.mjs && astro dev",
    "build": "node scripts/prepare-public.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check && node --check scripts/prepare-public.mjs && node --check scripts/documentation/artifacts.mjs",
    "test": "vitest run --maxWorkers=1 && playwright test",
    "test:int": "vitest run --maxWorkers=1",
    "test:e2e": "playwright test",
    "docs:import": "ruby scripts/documentation/import.rb",
    "format:check": "prettier --check src scripts tests astro.config.mjs playwright.config.ts vitest.config.mts",
    "docs:package": "ruby scripts/documentation/package.rb"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@playwright/test": "1.63.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  }
}
